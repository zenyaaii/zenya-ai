# ─────────────────────────────────────────────────────────────────────────
#  Zenya E2E — TEST-MODE overrides
#
#  Copy this file to `.env.test` and fill in TEST-mode values. Playwright
#  loads `.env.local` first, then lets `.env.test` OVERRIDE it — so the live
#  Stripe keys in `.env.local` are replaced by these test keys for the test
#  run only. `.env.test` is git-ignored.
#
#  Get everything below from the Stripe Dashboard with the "Test mode"
#  toggle ON (top-right). Nothing here can ever charge a real card.
# ─────────────────────────────────────────────────────────────────────────

# Stripe test API keys (Developers → API keys, Test mode)
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Test webhook signing secret.
#   Local: run `stripe listen --forward-to localhost:3000/api/webhook`
#   and paste the `whsec_…` it prints here.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# TEST-mode Price IDs (create matching prices in Test mode, then paste the
# price_… ids). These map to lib/checkout.ts → pickPriceId().
STRIPE_PRICE_ID=price_test_onetime            # one-time "pro" plan
STRIPE_PRICE_ID_STARTER_USD=price_test_starter # Starter subscription ($14.99)
STRIPE_PRICE_ID_PRO_USD=price_test_pro         # Pro subscription ($24.99)

# ── Optional: only needed for the domain availability/purchase E2E ──
# There is NO test sandbox for real domain registration — the suite stops at
# the Stripe test checkout URL and never completes a domain purchase. These
# keys only enable the read-only availability check + the pre-charge dry-run.
# PORKBUN_API_KEY=pk1_xxxxxxxx
# PORKBUN_SECRET_API_KEY=sk1_xxxxxxxx

# ── Optional: override the throwaway test account ──
# E2E_TEST_EMAIL=e2e-runner@zenya-test.local
# E2E_TEST_PASSWORD=Zenya-E2E-pw-9f3!x

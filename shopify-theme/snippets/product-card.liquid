{% comment %}
  Renders a product card.
  Accepts:
  - product: {Object} Product Liquid object.
  - class: {String} Extra classes.
{% endcomment %}

<div class="group relative {{ class }}" x-data="{ activeVariantId: {{ product.selected_or_first_available_variant.id | default: 'null' }}, activeImage: '{{ product.featured_image | image_url: width: 600 }}' }">
  <div class="relative aspect-[1/1] overflow-hidden rounded-xl bg-slate-100 mb-4">
    <a href="{{ product.url }}">
      <img 
        :src="activeImage" 
        width="{{ product.featured_image.width }}" 
        height="{{ product.featured_image.height }}"
        alt="{{ product.title }}" 
        class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
      >
      {% if product.images[1] %}
        <img 
          src="{{ product.images[1] | image_url: width: 600 }}" 
          width="{{ product.images[1].width }}"
          height="{{ product.images[1].height }}"
          alt="{{ product.title }}"
          class="absolute inset-0 h-full w-full object-cover opacity-0 transition duration-500 group-hover:opacity-100"
        >
      {% endif %}
    </a>

    <!-- Badges -->
    {% if product.compare_at_price > product.price %}
      <div class="absolute top-2 left-2 bg-red-500 text-white text-xs font-bold px-2 py-1 rounded shadow-sm">SALE</div>
    {% endif %}

    <!-- Quick View Button -->
    <button 
      @click="$dispatch('open-quick-view', { handle: '{{ product.handle }}' })"
      class="absolute bottom-4 right-4 h-10 w-10 bg-white text-slate-900 rounded-full shadow-lg flex items-center justify-center opacity-0 translate-y-4 transition duration-300 group-hover:opacity-100 group-hover:translate-y-0 hover:bg-primary hover:text-white"
      title="Quick View"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 5 8.268 7.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
    </button>
  </div>

  <h3 class="font-bold text-slate-900 group-hover:text-primary transition">
    <a href="{{ product.url }}">{{ product.title }}</a>
  </h3>
  
  <div class="flex items-center gap-2 mt-1">
    <span class="font-bold text-slate-900">{{ product.price | money }}</span>
    {% if product.compare_at_price > product.price %}
      <span class="text-sm text-slate-400 line-through">{{ product.compare_at_price | money }}</span>
    {% endif %}
  </div>

  <!-- Color Swatches -->
  {% for option in product.options_with_values %}
    {% assign option_name_downcase = option.name | downcase %}
    {% if option_name_downcase contains 'color' or option_name_downcase contains 'colour' %}
      <div class="flex flex-wrap gap-2 mt-3">
        {% for value in option.values %}
          {% assign variant = product.variants | where: option.name, value | first %}
          {% assign swatch_image = variant.image | image_url: width: 600 %}
          <button 
            @mouseenter="activeImage = '{{ swatch_image }}'" 
            @mouseleave="activeImage = '{{ product.featured_image | image_url: width: 600 }}'"
            class="w-6 h-6 rounded-full border border-slate-200 shadow-sm relative overflow-hidden hover:scale-110 transition"
            style="background-color: {{ value | split: ' ' | last | handle }};"
            title="{{ value }}"
          >
             <!-- Fallback if color name is complex, use simple logic or metaobject in real app -->
             <span class="sr-only">{{ value }}</span>
          </button>
        {% endfor %}
      </div>
    {% endif %}
  {% endfor %}
</div>

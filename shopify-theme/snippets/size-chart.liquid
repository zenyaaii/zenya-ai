<div 
  x-data="{ open: false }" 
  class="inline-block"
>
  <button 
    @click.prevent="open = true" 
    class="text-sm font-bold text-slate-500 underline hover:text-primary flex items-center gap-1"
  >
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"></path></svg>
    {{ block.settings.text | default: 'Size Chart' }}
  </button>

  <div 
    x-show="open" 
    class="fixed inset-0 z-[70] flex items-center justify-center p-4 bg-black/50 backdrop-blur-sm"
    x-cloak
  >
    <div 
      @click.away="open = false" 
      class="bg-white w-full max-w-lg rounded-2xl shadow-2xl overflow-hidden flex flex-col max-h-[90vh]"
    >
      <div class="p-4 border-b border-slate-100 flex items-center justify-between">
        <h3 class="font-bold text-lg">{{ block.settings.text | default: 'Size Chart' }}</h3>
        <button @click="open = false" class="text-slate-400 hover:text-slate-600">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>
      <div class="p-6 overflow-y-auto">
        {% if block.settings.page != blank %}
          <div class="prose prose-sm max-w-none">
            {{ pages[block.settings.page].content }}
          </div>
        {% else %}
          <table class="w-full text-sm text-left">
            <thead class="bg-slate-50 font-bold text-slate-900">
              <tr>
                <th class="p-2">Size</th>
                <th class="p-2">Chest</th>
                <th class="p-2">Waist</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <tr><td class="p-2">S</td><td class="p-2">34-36"</td><td class="p-2">28-30"</td></tr>
              <tr><td class="p-2">M</td><td class="p-2">38-40"</td><td class="p-2">32-34"</td></tr>
              <tr><td class="p-2">L</td><td class="p-2">42-44"</td><td class="p-2">36-38"</td></tr>
              <tr><td class="p-2">XL</td><td class="p-2">46-48"</td><td class="p-2">40-42"</td></tr>
            </tbody>
          </table>
          <p class="text-xs text-slate-500 mt-4 text-center">Standard sizing. Fits true to size.</p>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% if section.settings.enable_sticky_atc %}
<div 
  x-data="{ 
    visible: false,
    scrollTrigger: 600,
    checkScroll() {
      this.visible = window.scrollY > this.scrollTrigger;
    }
  }"
  @scroll.window="checkScroll()"
  x-show="visible"
  x-transition:enter="transition ease-out duration-300"
  x-transition:enter-start="translate-y-full"
  x-transition:enter-end="translate-y-0"
  x-transition:leave="transition ease-in duration-300"
  x-transition:leave-start="translate-y-0"
  x-transition:leave-end="translate-y-full"
  class="fixed bottom-0 left-0 w-full bg-white border-t border-slate-200 shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.1)] z-40 py-4 px-6 md:px-12"
  x-cloak
>
  <div class="container mx-auto flex items-center justify-between gap-4">
    <!-- Product Info (Hidden on mobile to save space) -->
    <div class="hidden md:flex items-center gap-4">
      {% if product.featured_image %}
        <img src="{{ product.featured_image | image_url: width: 60 }}" width="60" height="60" class="rounded-md border border-slate-100 object-cover">
      {% endif %}
      <div>
        <h3 class="font-bold text-slate-900 line-clamp-1">{{ product.title }}</h3>
        <div class="text-sm text-slate-500">{{ product.price | money }}</div>
      </div>
    </div>

    <!-- Mobile Title (Simplified) -->
    <div class="md:hidden font-bold text-sm line-clamp-1 text-slate-900">
      {{ product.title }}
    </div>

    <!-- Add to Cart Form -->
    {% form 'product', product, class: 'flex items-center gap-4' %}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      <div class="hidden sm:block">
        <select name="id" class="border-slate-200 rounded-lg text-sm py-2 pl-3 pr-8">
          {% for variant in product.variants %}
            <option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %} {% if variant == product.selected_or_first_available_variant %}selected{% endif %}>
              {{ variant.title }} - {{ variant.price | money }}
            </option>
          {% endfor %}
        </select>
      </div>
      <button 
        type="submit" 
        name="add" 
        class="bg-primary text-white font-bold py-3 px-8 rounded-full hover:opacity-90 transition shadow-lg whitespace-nowrap"
        style="background-color: {{ settings.primary_color }};"
        {% unless product.available %}disabled{% endunless %}
      >
        {% if product.available %}
          Add to Cart
        {% else %}
          Sold Out
        {% endif %}
      </button>
    {% endform %}
  </div>
</div>
{% endif %}

{% schema %}
{
  "name": "Sticky Cart",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_sticky_atc",
      "label": "Enable Sticky Add to Cart",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Sticky Cart"
    }
  ],
  "templates": ["product"]
}
{% endschema %}

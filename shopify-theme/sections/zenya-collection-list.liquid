﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿<div class="py-20" style="background-color: {{ section.settings.bg_color }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="container mx-auto px-6 max-w-{{ section.settings.container_width }}">
    {% if section.settings.title != blank %}
      <h2 class="font-bold mb-12 text-center {{ section.settings.heading_size }}" style="color: {{ section.settings.heading_color }}">{{ section.settings.title }}</h2>
    {% endif %}

    <div class="grid grid-cols-{{ section.settings.columns_mobile }} md:grid-cols-{{ section.settings.columns_desktop }} gap-8">
      {% for block in section.blocks %}
        {% assign collection = collections[block.settings.collection] %}
        <a href="{{ collection.url | default: '#' }}" class="group relative overflow-hidden rounded-2xl shadow-lg block" style="aspect-ratio: {{ section.settings.image_ratio }}">
          {% if collection.image != blank or collection.products.first.featured_image != blank %}
            {% assign image = collection.image | default: collection.products.first.featured_image %}
            <img 
              src="{{ image | image_url: width: 800 }}" 
              width="{{ image.width }}"
              height="{{ image.height }}"
              alt="{{ collection.title }}" 
              class="h-full w-full object-cover transition duration-700 group-hover:scale-110">
          {% else %}
             {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'h-full w-full object-cover bg-slate-200' }}
          {% endif %}
          
          <div class="absolute inset-0 transition duration-300" style="background-color: {{ section.settings.overlay_color }}; opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}"></div>
          
          <div class="absolute inset-0 flex p-8 {{ section.settings.text_position }}">
            <h3 class="text-2xl font-bold tracking-wide transition duration-300 group-hover:scale-105" style="color: {{ section.settings.text_color }}">
              {{ collection.title | default: "Collection Name" }}
            </h3>
          </div>
        </a>
      {% endfor %}
      
      {% if section.blocks.size == 0 %}
         {% for i in (1..3) %}
            <div class="group relative overflow-hidden rounded-2xl shadow-lg block bg-slate-200" style="aspect-ratio: {{ section.settings.image_ratio }}">
               <div class="absolute inset-0 flex items-center justify-center">
                  <h3 class="text-2xl font-bold text-slate-400">Category {{ i }}</h3>
               </div>
            </div>
         {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
    "name":  "Collection List",
    "settings":  [
                     {
                         "type":  "header",
                         "content":  "Content"
                     },
                     {
                         "type":  "text",
                         "id":  "title",
                         "label":  "Heading",
                         "default":  "Shop by Category"
                     },
                     {
                         "type":  "select",
                         "id":  "heading_size",
                         "label":  "Heading Size",
                         "options":  [
                                         {
                                             "value":  "text-2xl",
                                             "label":  "Small"
                                         },
                                         {
                                             "value":  "text-3xl",
                                             "label":  "Medium"
                                         },
                                         {
                                             "value":  "text-4xl",
                                             "label":  "Large"
                                         },
                                         {
                                             "value":  "text-5xl",
                                             "label":  "Extra Large"
                                         }
                                     ],
                         "default":  "text-3xl"
                     },
                     {
                         "type":  "header",
                         "content":  "Layout"
                     },
                     {
                         "type":  "select",
                         "id":  "container_width",
                         "label":  "Container Width",
                         "options":  [
                                         {
                                             "value":  "md",
                                             "label":  "Medium (768px)"
                                         },
                                         {
                                             "value":  "lg",
                                             "label":  "Large (1024px)"
                                         },
                                         {
                                             "value":  "xl",
                                             "label":  "Extra Large (1280px)"
                                         },
                                         {
                                             "value":  "2xl",
                                             "label":  "Full Width (1536px)"
                                         }
                                     ],
                         "default":  "2xl"
                     },
                     {
                         "type":  "range",
                         "id":  "columns_desktop",
                         "label":  "Desktop Columns",
                         "min":  2,
                         "max":  5,
                         "step":  1,
                         "default":  3
                     },
                     {
                         "type":  "select",
                         "id":  "columns_mobile",
                         "label":  "Mobile Columns",
                         "options":  [
                                         {
                                             "value":  "1",
                                             "label":  "1 Column"
                                         },
                                         {
                                             "value":  "2",
                                             "label":  "2 Columns"
                                         }
                                     ],
                         "default":  "1"
                     },
                     {
                         "type":  "select",
                         "id":  "image_ratio",
                         "label":  "Image Ratio",
                         "options":  [
                                         {
                                             "value":  "1/1",
                                             "label":  "Square"
                                         },
                                         {
                                             "value":  "3/4",
                                             "label":  "Portrait"
                                         },
                                         {
                                             "value":  "4/3",
                                             "label":  "Landscape"
                                         }
                                     ],
                         "default":  "4/3"
                     },
                     {
                         "type":  "select",
                         "id":  "text_position",
                         "label":  "Text Position",
                         "options":  [
                                         {
                                             "value":  "items-center justify-center text-center",
                                             "label":  "Center"
                                         },
                                         {
                                             "value":  "items-end justify-start text-left",
                                             "label":  "Bottom Left"
                                         }
                                     ],
                         "default":  "items-center justify-center text-center"
                     },
                     {
                         "type":  "header",
                         "content":  "Colors"
                     },
                     {
                         "type":  "color",
                         "id":  "bg_color",
                         "label":  "Background Color",
                         "default":  "#f8fafc"
                     },
                     {
                         "type":  "color",
                         "id":  "heading_color",
                         "label":  "Heading Color",
                         "default":  "#0f172a"
                     },
                     {
                         "type":  "color",
                         "id":  "text_color",
                         "label":  "Card Text Color",
                         "default":  "#ffffff"
                     },
                     {
                         "type":  "color",
                         "id":  "overlay_color",
                         "label":  "Overlay Color",
                         "default":  "#000000"
                     },
                     {
                         "type":  "range",
                         "id":  "overlay_opacity",
                         "min":  0,
                         "max":  90,
                         "step":  5,
                         "unit":  "%",
                         "label":  "Overlay Opacity",
                         "default":  30
                     },
                     {
                         "type":  "header",
                         "content":  "Spacing"
                     },
                     {
                         "type":  "range",
                         "id":  "padding_top",
                         "min":  0,
                         "max":  120,
                         "step":  4,
                         "unit":  "px",
                         "label":  "Padding Top",
                         "default":  80
                     },
                     {
                         "type":  "range",
                         "id":  "padding_bottom",
                         "min":  0,
                         "max":  120,
                         "step":  4,
                         "unit":  "px",
                         "label":  "Padding Bottom",
                         "default":  80
                     }
                 ],
    "blocks":  [
                   {
                       "type":  "collection",
                       "name":  "Collection",
                       "settings":  [
                                        {
                                            "type":  "collection",
                                            "id":  "collection",
                                            "label":  "Collection"
                                        }
                                    ]
                   }
               ],
    "presets":  [
                    {
                        "name":  "Collections",
                        "blocks":  [
                                       {
                                           "type":  "collection"
                                       },
                                       {
                                           "type":  "collection"
                                       },
                                       {
                                           "type":  "collection"
                                       }
                                   ]
                    }
                ]
}
{% endschema %}

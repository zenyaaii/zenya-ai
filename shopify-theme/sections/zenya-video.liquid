<div class="relative overflow-hidden" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="container mx-auto px-6 text-center">
    {% if section.settings.heading != blank %}
      <h2 class="text-3xl font-bold mb-8" style="color: {{ section.settings.heading_color }}">{{ section.settings.heading }}</h2>
    {% endif %}
    
    <div x-data="{ playing: false }" class="relative w-full max-w-5xl mx-auto aspect-video rounded-2xl overflow-hidden shadow-2xl border border-slate-700/20 bg-black">
      
      {% comment %} Cover Image {% endcomment %}
      {% if section.settings.cover != blank %}
        <div x-show="!playing" class="absolute inset-0 z-10 cursor-pointer group" @click="playing = true">
          <img src="{{ section.settings.cover | image_url: width: 1600 }}" alt="{{ section.settings.heading }}" class="w-full h-full object-cover transition duration-700 group-hover:scale-105">
          <div class="absolute inset-0 flex items-center justify-center bg-black/30 group-hover:bg-black/20 transition">
            <div class="w-20 h-20 bg-white/90 rounded-full flex items-center justify-center pl-1 shadow-lg group-hover:scale-110 transition duration-300">
               <svg class="w-8 h-8 text-black" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            </div>
          </div>
        </div>
      {% endif %}

      {% comment %} Video Player {% endcomment %}
      <template x-if="playing || {% if section.settings.cover == blank %}true{% else %}false{% endif %}">
         <div class="w-full h-full">
            {% if section.settings.video_url.type == 'youtube' %}
              <iframe :src="`https://www.youtube.com/embed/{{ section.settings.video_url.id }}?autoplay=1&enablejsapi=1`" class="absolute inset-0 w-full h-full" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
            {% elsif section.settings.video_url.type == 'vimeo' %}
              <iframe :src="`https://player.vimeo.com/video/{{ section.settings.video_url.id }}?autoplay=1`" class="absolute inset-0 w-full h-full" frameborder="0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
            {% endif %}
         </div>
      </template>

      {% if section.settings.video_url == blank %}
        <div class="flex items-center justify-center h-full text-slate-500 bg-slate-100">
          <p>Select a video in the editor</p>
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
    "name":  "Video",
    "settings":  [
                     {
                         "type":  "header",
                         "content":  "Content"
                     },
                     {
                         "type":  "text",
                         "id":  "heading",
                         "label":  "Heading",
                         "default":  "Watch Our Story"
                     },
                     {
                         "type":  "image_picker",
                         "id":  "cover",
                         "label":  "Cover Image"
                     },
                     {
                         "type":  "video_url",
                         "id":  "video_url",
                         "label":  "Video URL",
                         "accept":  [
                                        "youtube",
                                        "vimeo"
                                    ],
                         "default":  "https://www.youtube.com/watch?v=_9VUPq3SxOc"
                     },
                     {
                         "type":  "header",
                         "content":  "Colors"
                     },
                     {
                         "type":  "color",
                         "id":  "bg_color",
                         "label":  "Background Color",
                         "default":  "#0f172a"
                     },
                     {
                         "type":  "color",
                         "id":  "text_color",
                         "label":  "Text Color",
                         "default":  "#ffffff"
                     },
                     {
                         "type":  "color",
                         "id":  "heading_color",
                         "label":  "Heading Color",
                         "default":  "#ffffff"
                     },
                     {
                         "type":  "header",
                         "content":  "Layout"
                     },
                     {
                         "type":  "range",
                         "id":  "padding_top",
                         "min":  0,
                         "max":  120,
                         "step":  4,
                         "unit":  "px",
                         "label":  "Padding Top",
                         "default":  80
                     },
                     {
                         "type":  "range",
                         "id":  "padding_bottom",
                         "min":  0,
                         "max":  120,
                         "step":  4,
                         "unit":  "px",
                         "label":  "Padding Bottom",
                         "default":  80
                     }
                 ],
    "presets":  [
                    {
                        "name":  "Video"
                    }
                ]
}
{% endschema %}

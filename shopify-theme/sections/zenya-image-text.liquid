<div class="overflow-hidden" style="background-color: {{ section.settings.bg_color }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="container mx-auto px-6" style="max-width: {{ section.settings.container_width }}px;">
    <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-20">
      
      {% comment %} Image Column {% endcomment %}
      <div class="w-full lg:w-1/2 {% if section.settings.layout == 'right' %}lg:order-2{% endif %}">
        <div class="relative group">
          {% if section.settings.image != blank %}
            <img 
              src="{{ section.settings.image | image_url: width: 1200 }}" 
              alt="{{ section.settings.title }}" 
              class="w-full transition duration-500 group-hover:scale-[1.02]"
              style="border-radius: {{ section.settings.image_radius }}px; aspect-ratio: {{ section.settings.image_ratio }}; object-fit: cover; border: {{ section.settings.border_width }}px solid {{ section.settings.border_color }}; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, {{ section.settings.shadow_opacity | divided_by: 100.0 }});">
          {% else %}
            <div class="w-full bg-slate-200 flex items-center justify-center text-slate-400"
                 style="border-radius: {{ section.settings.image_radius }}px; aspect-ratio: {{ section.settings.image_ratio }}; border: {{ section.settings.border_width }}px solid {{ section.settings.border_color }};">
              {{ 'image' | placeholder_svg_tag: 'w-1/3 h-1/3 opacity-50' }}
            </div>
          {% endif %}
        </div>
      </div>

      {% comment %} Text Column {% endcomment %}
      <div class="w-full lg:w-1/2 space-y-6 text-{{ section.settings.text_align }}">
        {% if section.settings.title != blank %}
          <h2 class="font-bold leading-tight" style="color: {{ section.settings.heading_color }}; font-size: {{ section.settings.heading_size }}px;">{{ section.settings.title }}</h2>
        {% endif %}
        
        {% if section.settings.text != blank %}
          <div class="leading-relaxed rte" style="color: {{ section.settings.text_color }}; font-size: {{ section.settings.text_size }}px;">
            {{ section.settings.text }}
          </div>
        {% endif %}

        {% if section.settings.cta_text != blank %}
          <div class="pt-4">
            <a href="{{ section.settings.cta_url }}" 
               class="inline-flex items-center justify-center px-8 py-3.5 text-base font-bold shadow-lg transition duration-300 hover:opacity-90 hover:shadow-xl transform hover:-translate-y-0.5" 
               {% if section.settings.button_style == 'outline' %}
                 style="border: 2px solid {{ section.settings.button_bg_color }}; color: {{ section.settings.button_bg_color }}; background: transparent; border-radius: {{ section.settings.btn_radius }}px;"
               {% else %}
                 style="background-color: {{ section.settings.button_bg_color }}; color: {{ section.settings.button_text_color }}; border-radius: {{ section.settings.btn_radius }}px;"
               {% endif %}>
              {{ section.settings.cta_text }}
            </a>
          </div>
        {% endif %}
      </div>
      
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image Text",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Container Width",
      "default": 1200
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image Ratio",
      "options": [
        { "value": "auto", "label": "Adapt to image" },
        { "value": "1/1", "label": "Square" },
        { "value": "4/3", "label": "Landscape" },
        { "value": "3/4", "label": "Portrait" },
        { "value": "16/9", "label": "Wide" }
      ],
      "default": "4/3"
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Corner Radius",
      "default": 16
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Border Width",
      "default": 0
    },
    {
      "type": "range",
      "id": "shadow_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Shadow Opacity",
      "default": 10
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Image with text"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 40
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Pair text with an image to focus on your chosen product, collection, or blog post.</p>"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button Label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button Style",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "outline", "label": "Outline" }
      ],
      "default": "solid"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f8fafc"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#0f172a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#475569"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Image Border Color",
      "default": "#e2e8f0"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background/Border",
      "default": "#3b82f6"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Image Text"
    }
  ]
}
{% endschema %}
﻿
<div class="py-12 md:py-24" x-data="{ slider: {{ section.settings.initial_position }} }" style="background-color: {{ section.settings.bg_color }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="container mx-auto px-6 text-center max-w-{{ section.settings.container_width }}">
    {% if section.settings.heading != blank %}
      <h2 class="font-bold mb-12 {{ section.settings.heading_size }}" style="color: {{ section.settings.heading_color }}">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="relative w-full mx-auto rounded-2xl overflow-hidden shadow-2xl cursor-ew-resize select-none" style="aspect-ratio: {{ section.settings.image_ratio }};">
      
      <!-- After Image (Background) -->
      <div class="absolute inset-0">
        {% if section.settings.image_after != blank %}
          <img 
            src="{{ section.settings.image_after | image_url: width: 1200 }}" 
            width="{{ section.settings.image_after.width }}"
            height="{{ section.settings.image_after.height }}"
            class="w-full h-full object-cover">
        {% else %}
          <div class="w-full h-full bg-green-100 flex items-center justify-center text-green-800 font-bold text-4xl">AFTER</div>
        {% endif %}
        
        {% if section.settings.show_labels %}
          <span class="absolute bottom-4 right-4 px-3 py-1 rounded bg-black/50 text-white text-xs font-bold backdrop-blur-sm">{{ section.settings.label_after }}</span>
        {% endif %}
      </div>

      <!-- Before Image (Clipped) -->
      <div class="absolute inset-0 overflow-hidden" :style="'width: ' + slider + '%'">
        <div class="absolute inset-0 h-full" style="width: 100%; max-width: none;">
           {% if section.settings.image_before != blank %}
             <img 
               src="{{ section.settings.image_before | image_url: width: 1200 }}" 
               width="{{ section.settings.image_before.width }}"
               height="{{ section.settings.image_before.height }}"
               class="w-full h-full object-cover">
           {% else %}
             <div class="w-full h-full bg-red-100 flex items-center justify-center text-red-800 font-bold text-4xl">BEFORE</div>
           {% endif %}
           
           {% if section.settings.show_labels %}
             <span class="absolute bottom-4 left-4 px-3 py-1 rounded bg-black/50 text-white text-xs font-bold backdrop-blur-sm">{{ section.settings.label_before }}</span>
           {% endif %}
        </div>
      </div>

      <!-- Handle -->
      <div class="absolute top-0 bottom-0 w-1 cursor-ew-resize shadow-[0_0_10px_rgba(0,0,0,0.3)]" :style="'left: ' + slider + '%; background-color: ' + '{{ section.settings.handle_color }}'">
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-8 h-8 rounded-full flex items-center justify-center shadow-lg" style="background-color: {{ section.settings.handle_color }}; color: {{ section.settings.handle_icon_color }}">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 15L12 18.75 15.75 15m-7.5-6L12 5.25 15.75 9" />
          </svg>
        </div>
      </div>

      <!-- Input Range -->
      <input type="range" min="0" max="100" x-model="slider" class="absolute inset-0 w-full h-full opacity-0 cursor-ew-resize z-20">
    </div>
  </div>
</div>

{% schema %}
{
    "name":  "Before/After Slider",
    "settings":  [
                     {
                         "type":  "header",
                         "content":  "Content"
                     },
                     {
                         "type":  "text",
                         "id":  "heading",
                         "label":  "Heading",
                         "default":  "See the Difference"
                     },
                     {
                         "type":  "select",
                         "id":  "heading_size",
                         "label":  "Heading Size",
                         "options":  [
                                         {
                                             "value":  "text-2xl",
                                             "label":  "Small"
                                         },
                                         {
                                             "value":  "text-3xl",
                                             "label":  "Medium"
                                         },
                                         {
                                             "value":  "text-4xl",
                                             "label":  "Large"
                                         },
                                         {
                                             "value":  "text-5xl",
                                             "label":  "Extra Large"
                                         }
                                     ],
                         "default":  "text-3xl"
                     },
                     {
                         "type":  "image_picker",
                         "id":  "image_before",
                         "label":  "Before Image"
                     },
                     {
                         "type":  "image_picker",
                         "id":  "image_after",
                         "label":  "After Image"
                     },
                     {
                         "type":  "select",
                         "id":  "image_ratio",
                         "label":  "Image Ratio",
                         "options":  [
                                         {
                                             "value":  "16/9",
                                             "label":  "Landscape"
                                         },
                                         {
                                             "value":  "4/3",
                                             "label":  "Standard"
                                         },
                                         {
                                             "value":  "1/1",
                                             "label":  "Square"
                                         },
                                         {
                                             "value":  "3/4",
                                             "label":  "Portrait"
                                         }
                                     ],
                         "default":  "16/9"
                     },
                     {
                         "type":  "range",
                         "id":  "initial_position",
                         "min":  0,
                         "max":  100,
                         "step":  5,
                         "unit":  "%",
                         "label":  "Initial Slider Position",
                         "default":  50
                     },
                     {
                         "type":  "header",
                         "content":  "Labels"
                     },
                     {
                         "type":  "checkbox",
                         "id":  "show_labels",
                         "label":  "Show Labels",
                         "default":  true
                     },
                     {
                         "type":  "text",
                         "id":  "label_before",
                         "label":  "Before Label",
                         "default":  "Before"
                     },
                     {
                         "type":  "text",
                         "id":  "label_after",
                         "label":  "After Label",
                         "default":  "After"
                     },
                     {
                         "type":  "header",
                         "content":  "Colors"
                     },
                     {
                         "type":  "color",
                         "id":  "bg_color",
                         "label":  "Section Background",
                         "default":  "#f8fafc"
                     },
                     {
                         "type":  "color",
                         "id":  "heading_color",
                         "label":  "Heading Color",
                         "default":  "#0f172a"
                     },
                     {
                         "type":  "color",
                         "id":  "handle_color",
                         "label":  "Handle Color",
                         "default":  "#ffffff"
                     },
                     {
                         "type":  "color",
                         "id":  "handle_icon_color",
                         "label":  "Handle Icon Color",
                         "default":  "#0f172a"
                     },
                     {
                         "type":  "header",
                         "content":  "Layout"
                     },
                     {
                         "type":  "select",
                         "id":  "container_width",
                         "label":  "Container Width",
                         "options":  [
                                         {
                                             "value":  "md",
                                             "label":  "Medium (768px)"
                                         },
                                         {
                                             "value":  "lg",
                                             "label":  "Large (1024px)"
                                         },
                                         {
                                             "value":  "xl",
                                             "label":  "Extra Large (1280px)"
                                         },
                                         {
                                             "value":  "2xl",
                                             "label":  "Full Width (1536px)"
                                         }
                                     ],
                         "default":  "lg"
                     },
                     {
                         "type":  "range",
                         "id":  "padding_top",
                         "min":  0,
                         "max":  128,
                         "step":  4,
                         "unit":  "px",
                         "label":  "Padding Top",
                         "default":  64
                     },
                     {
                         "type":  "range",
                         "id":  "padding_bottom",
                         "min":  0,
                         "max":  128,
                         "step":  4,
                         "unit":  "px",
                         "label":  "Padding Bottom",
                         "default":  64
                     }
                 ],
    "presets":  [
                    {
                        "name":  "Compare"
                    }
                ]
}
{% endschema %}
  

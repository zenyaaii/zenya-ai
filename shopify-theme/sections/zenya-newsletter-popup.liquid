{% if section.settings.enable_popup %}
<div 
  x-data="{ 
    show: false, 
    dismissed: localStorage.getItem('zenya_newsletter_dismissed') === 'true',
    submit() {
      // Simulate submission or handle standard Shopify form submission
      localStorage.setItem('zenya_newsletter_dismissed', 'true');
      this.show = false;
    }
  }"
  x-init="
    if (!dismissed) {
      setTimeout(() => { show = true }, {{ section.settings.delay | times: 1000 }});
    }
  "
  x-show="show"
  x-transition:enter="transition ease-out duration-300"
  x-transition:enter-start="opacity-0 translate-y-4"
  x-transition:enter-end="opacity-100 translate-y-0"
  x-transition:leave="transition ease-in duration-300"
  x-transition:leave-start="opacity-100 translate-y-0"
  x-transition:leave-end="opacity-0 translate-y-4"
  class="fixed bottom-4 right-4 z-50 w-full max-w-md p-6 bg-white rounded-2xl shadow-2xl border border-slate-100 sm:bottom-8 sm:right-8"
  x-cloak
>
  <button @click="show = false; localStorage.setItem('zenya_newsletter_dismissed', 'true')" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
  </button>

  <div class="text-center">
    {% if section.settings.heading != blank %}
      <h3 class="text-xl font-bold text-slate-900 mb-2">{{ section.settings.heading }}</h3>
    {% endif %}
    {% if section.settings.text != blank %}
      <div class="text-slate-600 mb-6 text-sm">{{ section.settings.text }}</div>
    {% endif %}

    {% form 'customer', class: 'space-y-4' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="relative">
        <input 
          type="email" 
          name="contact[email]" 
          class="w-full px-4 py-3 border border-slate-200 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition" 
          placeholder="Enter your email"
          required
        >
      </div>
      <button 
        type="submit" 
        class="w-full py-3 px-6 bg-primary text-white font-bold rounded-lg shadow-lg hover:opacity-90 transition transform hover:scale-[1.02]"
        style="background-color: {{ settings.primary_color }};"
      >
        {{ section.settings.button_text }}
      </button>
      {% if form.posted_successfully? %}
        <p class="text-green-600 text-sm font-bold mt-2">Thanks for subscribing!</p>
        <script>
          localStorage.setItem('zenya_newsletter_dismissed', 'true');
        </script>
      {% endif %}
    {% endform %}
  </div>
</div>
{% endif %}

{% schema %}
{
  "name": "Newsletter Popup",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_popup",
      "label": "Enable Popup",
      "default": true
    },
    {
      "type": "range",
      "id": "delay",
      "min": 1,
      "max": 60,
      "step": 1,
      "unit": "sec",
      "label": "Delay (seconds)",
      "default": 5
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get 10% Off!"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Subscribe to our newsletter and get a special discount on your first order."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Subscribe"
    }
  ],
  "presets": [
    {
      "name": "Newsletter Popup"
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}

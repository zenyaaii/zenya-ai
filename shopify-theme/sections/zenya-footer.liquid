<footer class="relative border-t border-slate-200/70" style="background: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/70 to-transparent"></div>
  <div class="container mx-auto px-4 py-12 md:px-6">
    <div class="mb-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {% for block in section.blocks %}
        <div class="zenya-card border border-slate-200/70 p-5" {{ block.shopify_attributes }}>
          {% case block.type %}
            {% when 'brand_information' %}
              {% if block.settings.logo != blank %}
                {{ block.settings.logo | image_url: width: block.settings.logo_width | image_tag: class: 'h-auto mb-4', style: 'max-width: 100%;', alt: shop.name }}
              {% else %}
                <h3 class="mb-3 text-lg font-extrabold text-slate-900">{{ shop.name }}</h3>
              {% endif %}
              {% if block.settings.text != blank %}
                <div class="text-sm leading-relaxed text-slate-600">{{ block.settings.text }}</div>
              {% endif %}
              {% if block.settings.show_social %}
                <div class="mt-4 text-sm text-slate-600">
                  {% render 'social-icons', class: 'flex flex-wrap gap-3' %}
                </div>
              {% endif %}

            {% when 'link_list' %}
              <h4 class="mb-3 text-sm font-bold uppercase tracking-wide text-slate-900">{{ block.settings.heading | default: linklists[block.settings.menu].title }}</h4>
              <ul class="space-y-2 text-sm text-slate-600">
                {% for link in linklists[block.settings.menu].links %}
                  <li><a href="{{ link.url }}" class="transition hover:text-[var(--zenya-primary)]">{{ link.title }}</a></li>
                {% else %}
                  <li><a href="#" class="transition hover:text-[var(--zenya-primary)]">Menu Item 1</a></li>
                  <li><a href="#" class="transition hover:text-[var(--zenya-primary)]">Menu Item 2</a></li>
                {% endfor %}
              </ul>

            {% when 'text' %}
              <h4 class="mb-3 text-sm font-bold uppercase tracking-wide text-slate-900">{{ block.settings.heading }}</h4>
              <div class="prose prose-sm max-w-none text-slate-600">{{ block.settings.text }}</div>

            {% when 'newsletter' %}
              <h4 class="mb-2 text-sm font-bold uppercase tracking-wide text-slate-900">{{ block.settings.heading }}</h4>
              <p class="mb-4 text-sm text-slate-600">{{ block.settings.text }}</p>
              {% form 'customer', class: 'space-y-2' %}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <label class="sr-only" for="footer-newsletter-email">Email address</label>
                <input id="footer-newsletter-email" type="email" name="contact[email]" required placeholder="Email address" class="w-full rounded-full border border-slate-300 bg-white px-4 py-2 text-sm text-slate-900 focus:border-[var(--zenya-primary)] focus:ring-[var(--zenya-primary)]">
                <button type="submit" class="w-full rounded-full px-4 py-2 text-sm font-semibold text-white transition hover:opacity-90" style="background: {{ settings.primary_color }};">Subscribe</button>
                {% if form.posted_successfully? %}
                  <p class="text-xs font-semibold text-emerald-700">Thanks for subscribing.</p>
                {% endif %}
              {% endform %}
          {% endcase %}
        </div>
      {% endfor %}
    </div>

    <div class="flex flex-col gap-4 border-t border-slate-200/80 pt-6 md:flex-row md:items-center md:justify-between">
      <div class="text-xs text-slate-500">
        {{ section.settings.copyright | replace: '%year%', 'now' | date: '%Y' | replace: '%shop_name%', shop.name }}
      </div>

      {% if section.settings.show_payment_icons %}
        <div class="flex flex-wrap items-center gap-2">
          {% for type in shop.enabled_payment_types %}
            <div class="rounded-md border border-slate-200 bg-white px-2 py-1">
              {{ type | payment_type_svg_tag: class: 'h-4' }}
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    {% if section.settings.enable_country_selector or section.settings.enable_language_selector %}
      <div class="mt-4">
        {% form 'localization' %}
          <div class="flex flex-wrap items-center gap-2">
            {% if section.settings.enable_country_selector and localization.available_countries.size > 1 %}
              <label class="sr-only" for="footer-country">Country</label>
              <select id="footer-country" name="country_code" class="rounded-full border border-slate-300 bg-white px-3 py-2 text-xs">
                {% for country in localization.available_countries %}
                  <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>
                    {{ country.name }} ({{ country.currency.iso_code }})
                  </option>
                {% endfor %}
              </select>
            {% endif %}
            {% if section.settings.enable_language_selector and localization.available_languages.size > 1 %}
              <label class="sr-only" for="footer-language">Language</label>
              <select id="footer-language" name="language_code" class="rounded-full border border-slate-300 bg-white px-3 py-2 text-xs">
                {% for language in localization.available_languages %}
                  <option value="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>
                    {{ language.endonym_name | capitalize }}
                  </option>
                {% endfor %}
              </select>
            {% endif %}
            <button type="submit" class="rounded-full border border-slate-300 px-3 py-2 text-xs font-semibold text-slate-700">Update</button>
          </div>
        {% endform %}
      </div>
    {% endif %}
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f8fafc"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#0f172a"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright Text",
      "default": "© %year% %shop_name%. All rights reserved."
    },
    {
      "type": "header",
      "content": "Payment Icons"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show Payment Icons",
      "default": true
    },
    {
      "type": "header",
      "content": "Localization"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "label": "Enable Country Selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "label": "Enable Language Selector",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "brand_information",
      "name": "Brand Information",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "range",
          "id": "logo_width",
          "min": 50,
          "max": 300,
          "step": 10,
          "default": 150,
          "unit": "px",
          "label": "Logo Width"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Premium quality products designed for your lifestyle.</p>"
        },
        {
          "type": "checkbox",
          "id": "show_social",
          "label": "Show Social Media Icons",
          "default": true
        }
      ]
    },
    {
      "type": "link_list",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "info": "Defaults to menu title"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "About Us"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Share store details, promotions, or brand content with your customers.</p>"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Subscribe"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Get the latest updates."
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "brand_information" },
      { "type": "link_list" },
      { "type": "link_list" }
    ]
  },
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}

﻿
<div class="{% unless section.settings.full_width %}container mx-auto px-6{% endunless %} py-12">
  {{ section.settings.custom_liquid }}
</div>
{% schema %}
{
    "name":  "Custom Liquid",
    "settings":  [
                     {
                         "type":  "liquid",
                         "id":  "custom_liquid",
                         "label":  "Custom Liquid",
                         "info":  "Add app snippets or other code to create advanced customizations."
                     },
                     {
                         "type":  "checkbox",
                         "id":  "full_width",
                         "label":  "Full Width",
                         "default":  false
                     }
                 ],
    "presets":  [
                    {
                        "name":  "Custom"
                    }
                ]
}
{% endschema %}
  

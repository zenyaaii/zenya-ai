<div class="py-24" style="background-color: {{ section.settings.bg_color }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="container mx-auto px-6" style="max-width: {{ section.settings.container_width }}px;">
    {% if section.settings.title != blank %}
      <h2 class="text-center font-extrabold mb-16 {{ section.settings.heading_size }}" style="color: {{ section.settings.heading_color }}">{{ section.settings.title }}</h2>
    {% endif %}
    
    <div class="grid gap-8 grid-cols-{{ section.settings.columns_mobile }} md:grid-cols-{{ section.settings.columns_desktop }}">
      {% for block in section.blocks %}
        <div class="p-8 transition duration-300 hover:-translate-y-1 flex flex-col {{ section.settings.shadow_size }}" 
             style="background-color: {{ section.settings.card_bg_color }}; 
                    border: {{ section.settings.border_width }}px solid {{ section.settings.card_border_color }}; 
                    border-radius: {{ section.settings.border_radius }}px;">
          
          <!-- Stars -->
          <div class="flex mb-6" style="color: {{ section.settings.star_color }}">
            {% assign rating = block.settings.stars | default: 5 %}
            {% for i in (1..rating) %}
              <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            {% endfor %}
          </div>

          <!-- Text -->
          <p class="mb-8 leading-relaxed italic flex-grow {{ section.settings.text_size }}" style="color: {{ section.settings.text_color }}">"{{ block.settings.text }}"</p>
          
          <!-- Author -->
          <div class="flex items-center gap-4 mt-auto">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 100, height: 100, crop: 'center' }}" width="100" height="100" alt="{{ block.settings.name }}" class="object-cover border-2 rounded-full" style="border-color: {{ section.settings.card_border_color }}; width: {{ section.settings.author_image_size }}px; height: {{ section.settings.author_image_size }}px;">
            {% else %}
               <div class="rounded-full flex items-center justify-center font-bold text-lg uppercase" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.heading_color }}; width: {{ section.settings.author_image_size }}px; height: {{ section.settings.author_image_size }}px;">
                 {{ block.settings.name | slice: 0 }}
               </div>
            {% endif %}
            
            <div>
              <div class="font-bold" style="color: {{ section.settings.heading_color }}">{{ block.settings.name }}</div>
              <div class="text-sm opacity-80" style="color: {{ section.settings.text_color }}">{{ block.settings.location }}</div>
            </div>
          </div>

        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
    "name":  "Testimonials",
    "settings":  [
                     {
                         "type":  "header",
                         "content":  "Content"
                     },
                     {
                         "type":  "text",
                         "id":  "title",
                         "label":  "Heading",
                         "default":  "What people are saying"
                     },
                     {
                         "type":  "select",
                         "id":  "heading_size",
                         "label":  "Heading Size",
                         "options":  [
                                         {
                                             "value":  "text-3xl",
                                             "label":  "Medium"
                                         },
                                         {
                                             "value":  "text-4xl",
                                             "label":  "Large"
                                         },
                                         {
                                             "value":  "text-5xl",
                                             "label":  "Extra Large"
                                         }
                                     ],
                         "default":  "text-4xl"
                     },
                     {
                         "type":  "select",
                         "id":  "text_size",
                         "label":  "Text Size",
                         "options":  [
                                         {
                                             "value":  "text-base",
                                             "label":  "Small"
                                         },
                                         {
                                             "value":  "text-lg",
                                             "label":  "Medium"
                                         },
                                         {
                                             "value":  "text-xl",
                                             "label":  "Large"
                                         }
                                     ],
                         "default":  "text-lg"
                     },
                     {
                         "type":  "header",
                         "content":  "Layout"
                     },
                     {
                         "type":  "range",
                         "id":  "container_width",
                         "min":  800,
                         "max":  1600,
                         "step":  50,
                         "unit":  "px",
                         "label":  "Container Width",
                         "default":  1200
                     },
                     {
                         "type":  "range",
                         "id":  "columns_desktop",
                         "label":  "Desktop Columns",
                         "min":  1,
                         "max":  4,
                         "step":  1,
                         "default":  3
                     },
                     {
                         "type":  "select",
                         "id":  "columns_mobile",
                         "label":  "Mobile Columns",
                         "options":  [
                                         {
                                             "value":  "1",
                                             "label":  "1 Column"
                                         },
                                         {
                                             "value":  "2",
                                             "label":  "2 Columns"
                                         }
                                     ],
                         "default":  "1"
                     },
                     {
                         "type":  "range",
                         "id":  "border_width",
                         "min":  0,
                         "max":  5,
                         "step":  1,
                         "unit":  "px",
                         "label":  "Card Border Width",
                         "default":  1
                     },
                     {
                         "type":  "range",
                         "id":  "border_radius",
                         "min":  0,
                         "max":  40,
                         "step":  4,
                         "unit":  "px",
                         "label":  "Card Border Radius",
                         "default":  16
                     },
                     {
                         "type":  "select",
                         "id":  "shadow_size",
                         "label":  "Card Shadow",
                         "options":  [
                                         {
                                             "value":  "",
                                             "label":  "None"
                                         },
                                         {
                                             "value":  "shadow-sm",
                                             "label":  "Small"
                                         },
                                         {
                                             "value":  "shadow-md",
                                             "label":  "Medium"
                                         },
                                         {
                                             "value":  "shadow-lg",
                                             "label":  "Large"
                                         },
                                         {
                                             "value":  "shadow-xl",
                                             "label":  "Extra Large"
                                         }
                                     ],
                         "default":  "shadow-xl"
                     },
                     {
                         "type":  "range",
                         "id":  "author_image_size",
                         "min":  32,
                         "max":  80,
                         "step":  4,
                         "unit":  "px",
                         "label":  "Author Image Size",
                         "default":  48
                     },
                     {
                         "type":  "header",
                         "content":  "Colors"
                     },
                     {
                         "type":  "color",
                         "id":  "bg_color",
                         "label":  "Section Background",
                         "default":  "#0f172a"
                     },
                     {
                         "type":  "color",
                         "id":  "card_bg_color",
                         "label":  "Card Background",
                         "default":  "#1e293b"
                     },
                     {
                         "type":  "color",
                         "id":  "card_border_color",
                         "label":  "Card Border",
                         "default":  "#334155"
                     },
                     {
                         "type":  "color",
                         "id":  "heading_color",
                         "label":  "Heading Color",
                         "default":  "#ffffff"
                     },
                     {
                         "type":  "color",
                         "id":  "text_color",
                         "label":  "Text Color",
                         "default":  "#cbd5e1"
                     },
                     {
                         "type":  "color",
                         "id":  "star_color",
                         "label":  "Star Color",
                         "default":  "#facc15"
                     },
                     {
                         "type":  "header",
                         "content":  "Spacing"
                     },
                     {
                         "type":  "range",
                         "id":  "padding_top",
                         "min":  0,
                         "max":  120,
                         "step":  4,
                         "unit":  "px",
                         "label":  "Padding Top",
                         "default":  96
                     },
                     {
                         "type":  "range",
                         "id":  "padding_bottom",
                         "min":  0,
                         "max":  120,
                         "step":  4,
                         "unit":  "px",
                         "label":  "Padding Bottom",
                         "default":  96
                     }
                 ],
    "blocks":  [
                   {
                       "type":  "testimonial",
                       "name":  "Testimonial",
                       "settings":  [
                                        {
                                            "type":  "image_picker",
                                            "id":  "image",
                                            "label":  "Author Image"
                                        },
                                        {
                                            "type":  "text",
                                            "id":  "name",
                                            "label":  "Name",
                                            "default":  "Author Name"
                                        },
                                        {
                                            "type":  "textarea",
                                            "id":  "text",
                                            "label":  "Review",
                                            "default":  "Add customer reviews and testimonials to showcase your store\u0027s happy customers."
                                        },
                                        {
                                            "type":  "text",
                                            "id":  "location",
                                            "label":  "Location",
                                            "default":  "Los Angeles, CA"
                                        },
                                        {
                                            "type":  "range",
                                            "id":  "stars",
                                            "min":  1,
                                            "max":  5,
                                            "step":  1,
                                            "label":  "Star Rating",
                                            "default":  5
                                        }
                                    ]
                   }
               ],
    "presets":  [
                    {
                        "name":  "Testimonials",
                        "blocks":  [
                                       {
                                           "type":  "testimonial",
                                           "settings":  {
                                                            "name":  "Alice",
                                                            "text":  "Amazing theme! It\u0027s so easy to customize and looks great on mobile.",
                                                            "location":  "NY"
                                                        }
                                       },
                                       {
                                           "type":  "testimonial",
                                           "settings":  {
                                                            "name":  "Bob",
                                                            "text":  "Increased my sales by 20% in the first week. Highly recommended!",
                                                            "location":  "CA"
                                                        }
                                       },
                                       {
                                           "type":  "testimonial",
                                           "settings":  {
                                                            "name":  "Charlie",
                                                            "text":  "Best investment ever. The support team is also very helpful.",
                                                            "location":  "UK"
                                                        }
                                       }
                                   ]
                    }
                ]
}
{% endschema %}

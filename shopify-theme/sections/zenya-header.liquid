<header
  class="sticky top-0 z-40 border-b border-slate-200/70 backdrop-blur"
  style="background: color-mix(in srgb, {{ section.settings.bg_color }} 92%, white 8%); color: {{ section.settings.text_color }};"
  x-data="{
    mobileMenuOpen: false,
    searchOpen: false,
    searchQuery: '',
    searchResults: [],
    loading: false,
    performSearch() {
      if (this.searchQuery.length < 2) {
        this.searchResults = [];
        return;
      }
      this.loading = true;
      fetch(`/search/suggest.json?q=${this.searchQuery}&resources[type]=product&resources[limit]=5`)
        .then((r) => r.json())
        .then((data) => { this.searchResults = data.resources.results.products || []; })
        .catch(() => { this.searchResults = []; })
        .finally(() => { this.loading = false; });
    }
  }"
>
  <div class="container mx-auto px-4 md:px-6">
    <div class="flex h-16 items-center justify-between gap-4 md:h-20">
      <a href="{{ routes.root_url }}" class="shrink-0 no-underline transition hover:opacity-90" style="color: inherit;">
        {% if section.settings.logo != blank %}
          {{ section.settings.logo | image_url: width: section.settings.logo_width | image_tag: class: 'h-auto', style: 'max-width: 100%;', loading: 'eager', alt: shop.name }}
        {% else %}
          <span class="text-xl font-extrabold tracking-tight md:text-2xl">{{ section.settings.shop_name | default: shop.name }}</span>
        {% endif %}
      </a>

      <nav class="hidden items-center gap-7 text-sm font-semibold md:flex">
        {% for link in linklists[section.settings.menu].links %}
          {% assign mega_menu_block = nil %}
          {% for block in section.blocks %}
            {% if block.settings.trigger_link_title == link.title %}
              {% assign mega_menu_block = block %}
              {% break %}
            {% endif %}
          {% endfor %}

          <div class="group relative" x-data="{ open: false }" @mouseenter="open = true" @mouseleave="open = false">
            <a href="{{ link.url }}" class="inline-flex items-center gap-1 py-2 transition hover:opacity-80" style="color: inherit;">
              {{ link.title }}
              {% if link.links != blank or mega_menu_block != nil %}
                <svg class="h-4 w-4 transition group-hover:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 9 6 6 6-6"></path>
                </svg>
              {% endif %}
            </a>

            {% if mega_menu_block != nil %}
              <div
                x-show="open"
                x-transition
                x-cloak
                class="absolute left-1/2 top-full z-50 w-[min(980px,92vw)] -translate-x-1/2 rounded-[calc(var(--zenya-radius)+6px)] border border-slate-200 bg-white p-6 shadow-2xl"
              >
                <div class="grid grid-cols-12 gap-6">
                  <div class="col-span-8 grid grid-cols-2 gap-5">
                    {% if link.links != blank %}
                      {% for child_link in link.links %}
                        <div>
                          <a href="{{ child_link.url }}" class="mb-2 block text-sm font-bold text-slate-900 hover:text-[var(--zenya-primary)]">{{ child_link.title }}</a>
                          <ul class="space-y-1 text-sm text-slate-600">
                            {% for grandchild_link in child_link.links %}
                              <li><a href="{{ grandchild_link.url }}" class="hover:text-[var(--zenya-primary)]">{{ grandchild_link.title }}</a></li>
                            {% endfor %}
                          </ul>
                        </div>
                      {% endfor %}
                    {% endif %}
                  </div>
                  <div class="col-span-4 grid grid-cols-1 gap-3">
                    {% if mega_menu_block.settings.promo_image_1 %}
                      <a href="{{ mega_menu_block.settings.promo_url_1 }}" class="group block overflow-hidden rounded-xl border border-slate-200">
                        <img src="{{ mega_menu_block.settings.promo_image_1 | image_url: width: 480 }}" width="480" height="320" alt="{{ mega_menu_block.settings.promo_text_1 | escape }}" class="h-28 w-full object-cover transition duration-500 group-hover:scale-105">
                        <div class="p-3 text-sm font-semibold text-slate-800">{{ mega_menu_block.settings.promo_text_1 }}</div>
                      </a>
                    {% endif %}
                    {% if mega_menu_block.settings.promo_image_2 %}
                      <a href="{{ mega_menu_block.settings.promo_url_2 }}" class="group block overflow-hidden rounded-xl border border-slate-200">
                        <img src="{{ mega_menu_block.settings.promo_image_2 | image_url: width: 480 }}" width="480" height="320" alt="{{ mega_menu_block.settings.promo_text_2 | escape }}" class="h-28 w-full object-cover transition duration-500 group-hover:scale-105">
                        <div class="p-3 text-sm font-semibold text-slate-800">{{ mega_menu_block.settings.promo_text_2 }}</div>
                      </a>
                    {% endif %}
                  </div>
                </div>
              </div>
            {% elsif link.links != blank %}
              <div x-show="open" x-transition x-cloak class="absolute left-0 top-full z-50 mt-1 w-60 rounded-xl border border-slate-200 bg-white p-2 shadow-xl">
                {% for child_link in link.links %}
                  <a href="{{ child_link.url }}" class="block rounded-lg px-3 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-[var(--zenya-primary)]">{{ child_link.title }}</a>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        {% else %}
          <a href="{{ routes.root_url }}">Home</a>
          <a href="{{ routes.all_products_collection_url }}">Shop</a>
        {% endfor %}
      </nav>

      <div class="hidden items-center gap-2 md:flex">
        <button @click="searchOpen = true; $nextTick(() => $refs.searchInput.focus())" class="rounded-full border border-slate-200 p-2 text-slate-700 transition hover:border-slate-300">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"></path></svg>
        </button>
        <a href="{{ routes.cart_url }}" @click.prevent="$dispatch('toggle-cart')" class="inline-flex items-center gap-2 rounded-full border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-slate-300">
          Cart
          {% if cart.item_count > 0 %}
            <span class="rounded-full px-2 py-0.5 text-xs font-bold text-white" style="background: {{ settings.primary_color }};">{{ cart.item_count }}</span>
          {% endif %}
        </a>
      </div>

      <div class="flex items-center gap-2 md:hidden">
        <button @click="searchOpen = true; $nextTick(() => $refs.searchInput.focus())" class="rounded-full border border-slate-200 p-2">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"></path></svg>
        </button>
        <button @click="mobileMenuOpen = !mobileMenuOpen" class="rounded-full border border-slate-200 p-2">
          <svg x-show="!mobileMenuOpen" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" x-cloak><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
          <svg x-show="mobileMenuOpen" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" x-cloak><path d="m6 6 12 12M18 6 6 18"></path></svg>
        </button>
      </div>
    </div>
  </div>

  <div x-show="mobileMenuOpen" x-transition x-cloak class="border-t border-slate-200 bg-white/95 md:hidden">
    <nav class="container mx-auto grid gap-1 px-4 py-4 text-sm font-semibold text-slate-700">
      {% for link in linklists[section.settings.menu].links %}
        <a href="{{ link.url }}" class="rounded-lg px-3 py-2 hover:bg-slate-50">{{ link.title }}</a>
      {% else %}
        <a href="{{ routes.root_url }}" class="rounded-lg px-3 py-2 hover:bg-slate-50">Home</a>
        <a href="{{ routes.all_products_collection_url }}" class="rounded-lg px-3 py-2 hover:bg-slate-50">Shop</a>
      {% endfor %}
      <a href="{{ routes.cart_url }}" @click.prevent="$dispatch('toggle-cart'); mobileMenuOpen = false" class="rounded-lg px-3 py-2 hover:bg-slate-50">Cart</a>
    </nav>
  </div>

  <div x-show="searchOpen" x-cloak class="fixed inset-0 z-50 bg-black/50 p-4 backdrop-blur-sm">
    <div @click.away="searchOpen = false" class="mx-auto mt-20 w-full max-w-2xl overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl">
      <div class="flex items-center gap-3 border-b border-slate-200 px-4 py-3">
        <svg class="h-5 w-5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"></path></svg>
        <input
          x-ref="searchInput"
          type="text"
          x-model="searchQuery"
          @input.debounce.300ms="performSearch()"
          placeholder="Search products..."
          class="w-full border-none text-base focus:ring-0"
        >
        <button @click="searchOpen = false" class="rounded-full p-1 text-slate-400 hover:bg-slate-100">X</button>
      </div>
      <div class="max-h-[60vh] overflow-y-auto p-4">
        <p x-show="loading" class="py-8 text-center text-sm text-slate-500">Searching...</p>
        <p x-show="!loading && searchQuery.length >= 2 && searchResults.length === 0" class="py-8 text-center text-sm text-slate-500">No matching products.</p>
        <div x-show="!loading && searchResults.length > 0" class="space-y-2">
          <template x-for="result in searchResults" :key="result.id">
            <a :href="result.url" class="flex items-center gap-3 rounded-xl p-2 hover:bg-slate-50">
              <img :src="result.featured_image.url" :alt="result.title" width="56" height="56" class="h-14 w-14 rounded-lg object-cover">
              <div>
                <p class="text-sm font-semibold text-slate-900" x-text="result.title"></p>
                <p class="text-xs text-slate-500" x-text="'{{ cart.currency.symbol }}' + result.price"></p>
              </div>
            </a>
          </template>
        </div>
      </div>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "shop_name",
      "label": "Shop Name",
      "default": "Zenya Demo Store"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 5,
      "unit": "px",
      "label": "Logo Width",
      "default": 120
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#0f172a"
    }
  ],
  "blocks": [
    {
      "type": "mega_menu",
      "name": "Mega Menu",
      "settings": [
        {
          "type": "text",
          "id": "trigger_link_title",
          "label": "Trigger Link Title",
          "info": "Must match a top-level menu item exactly (e.g., Shop)."
        },
        {
          "type": "image_picker",
          "id": "promo_image_1",
          "label": "Promo Image 1"
        },
        {
          "type": "text",
          "id": "promo_text_1",
          "label": "Promo Text 1"
        },
        {
          "type": "url",
          "id": "promo_url_1",
          "label": "Promo Link 1"
        },
        {
          "type": "image_picker",
          "id": "promo_image_2",
          "label": "Promo Image 2"
        },
        {
          "type": "text",
          "id": "promo_text_2",
          "label": "Promo Text 2"
        },
        {
          "type": "url",
          "id": "promo_url_2",
          "label": "Promo Link 2"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Header"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}

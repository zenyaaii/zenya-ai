<div class="py-24" style="background-color: {{ section.settings.bg_color }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="container mx-auto px-6" style="max-width: {{ section.settings.container_width }}px;">
    {% if section.settings.title != blank %}
      <h2 class="text-3xl font-bold mb-12 text-{{ section.settings.text_align }}" style="color: {{ section.settings.heading_color }}">{{ section.settings.title }}</h2>
    {% endif %}

    <div class="grid md:grid-cols-{{ section.settings.columns_desktop }} grid-cols-{{ section.settings.columns_mobile }}" style="gap: {{ section.settings.gap }}px;">
      {% for block in section.blocks %}
        <div class="p-8 transition duration-300 hover:-translate-y-1" 
             style="background-color: {{ section.settings.card_bg_color }}; 
                    border: {{ section.settings.border_width }}px solid {{ section.settings.card_border_color }}; 
                    border-radius: {{ section.settings.border_radius }}px; 
                    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, {{ section.settings.shadow_opacity | divided_by: 100.0 }}); 
                    text-align: {{ section.settings.text_align }}">
          <div class="rounded-xl flex items-center justify-center mb-6 {% if section.settings.text_align == 'center' %}mx-auto{% endif %}" style="background-color: {{ section.settings.icon_bg_color }}; color: {{ section.settings.icon_color }}; width: {{ section.settings.icon_size }}px; height: {{ section.settings.icon_size }}px; font-size: {{ section.settings.icon_size | divided_by: 2 }}px;">
            {% if block.settings.icon_svg != blank %}
              <div style="width: {{ section.settings.icon_size | divided_by: 2 }}px; height: {{ section.settings.icon_size | divided_by: 2 }}px;">
                {{ block.settings.icon_svg }}
              </div>
            {% else %}
              ★
            {% endif %}
          </div>
          <h3 class="font-bold mb-2" style="color: {{ section.settings.heading_color }}; font-size: {{ section.settings.heading_size }}px;">{{ block.settings.title }}</h3>
          <p class="leading-relaxed" style="color: {{ section.settings.text_color }}; font-size: {{ section.settings.text_size }}px;">{{ block.settings.desc }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</div>
{% schema %}
{
    "name":  "Features",
    "settings":  [
                     {
                         "type":  "header",
                         "content":  "Content"
                     },
                     {
                         "type":  "text",
                         "id":  "title",
                         "label":  "Heading",
                         "default":  "Why Choose Us"
                     },
                     {
                         "type":  "header",
                         "content":  "Layout"
                     },
                     {
                         "type":  "range",
                         "id":  "container_width",
                         "min":  800,
                         "max":  1600,
                         "step":  50,
                         "unit":  "px",
                         "label":  "Container Width",
                         "default":  1200
                     },
                     {
                         "type":  "range",
                         "id":  "columns_desktop",
                         "label":  "Desktop Columns",
                         "min":  2,
                         "max":  4,
                         "step":  1,
                         "default":  3
                     },
                     {
                         "type":  "select",
                         "id":  "columns_mobile",
                         "label":  "Mobile Columns",
                         "options":  [
                                         {
                                             "value":  "1",
                                             "label":  "1 Column"
                                         },
                                         {
                                             "value":  "2",
                                             "label":  "2 Columns"
                                         }
                                     ],
                         "default":  "1"
                     },
                     {
                         "type":  "range",
                         "id":  "gap",
                         "label":  "Grid Gap",
                         "min":  16,
                         "max":  64,
                         "step":  4,
                         "unit":  "px",
                         "default":  32
                     },
                     {
                         "type":  "select",
                         "id":  "text_align",
                         "label":  "Alignment",
                         "options":  [
                                         {
                                             "value":  "left",
                                             "label":  "Left"
                                         },
                                         {
                                             "value":  "center",
                                             "label":  "Center"
                                         }
                                     ],
                         "default":  "left"
                     },
                     {
                         "type":  "header",
                         "content":  "Card Styling"
                     },
                     {
                         "type":  "range",
                         "id":  "border_width",
                         "label":  "Card Border Width",
                         "min":  0,
                         "max":  5,
                         "step":  1,
                         "unit":  "px",
                         "default":  1
                     },
                     {
                         "type":  "range",
                         "id":  "border_radius",
                         "label":  "Card Corner Radius",
                         "min":  0,
                         "max":  40,
                         "step":  4,
                         "unit":  "px",
                         "default":  16
                     },
                     {
                         "type":  "range",
                         "id":  "shadow_opacity",
                         "label":  "Shadow Opacity",
                         "min":  0,
                         "max":  40,
                         "step":  5,
                         "unit":  "%",
                         "default":  10
                     },
                     {
                         "type":  "header",
                         "content":  "Typography \u0026 Icons"
                     },
                     {
                         "type":  "range",
                         "id":  "heading_size",
                         "label":  "Heading Size",
                         "min":  16,
                         "max":  40,
                         "step":  2,
                         "unit":  "px",
                         "default":  20
                     },
                     {
                         "type":  "range",
                         "id":  "text_size",
                         "label":  "Description Size",
                         "min":  14,
                         "max":  24,
                         "step":  1,
                         "unit":  "px",
                         "default":  16
                     },
                     {
                         "type":  "range",
                         "id":  "icon_size",
                         "label":  "Icon Box Size",
                         "min":  32,
                         "max":  80,
                         "step":  4,
                         "unit":  "px",
                         "default":  48
                     },
                     {
                         "type":  "header",
                         "content":  "Colors"
                     },
                     {
                         "type":  "color",
                         "id":  "bg_color",
                         "label":  "Section Background",
                         "default":  "#f8fafc"
                     },
                     {
                         "type":  "color",
                         "id":  "card_bg_color",
                         "label":  "Card Background",
                         "default":  "#ffffff"
                     },
                     {
                         "type":  "color",
                         "id":  "card_border_color",
                         "label":  "Card Border",
                         "default":  "#e2e8f0"
                     },
                     {
                         "type":  "color",
                         "id":  "heading_color",
                         "label":  "Heading Color",
                         "default":  "#0f172a"
                     },
                     {
                         "type":  "color",
                         "id":  "text_color",
                         "label":  "Text Color",
                         "default":  "#475569"
                     },
                     {
                         "type":  "color",
                         "id":  "icon_color",
                         "label":  "Icon Color",
                         "default":  "#2563eb"
                     },
                     {
                         "type":  "color",
                         "id":  "icon_bg_color",
                         "label":  "Icon Background",
                         "default":  "#eff6ff"
                     },
                     {
                         "type":  "header",
                         "content":  "Spacing"
                     },
                     {
                         "type":  "range",
                         "id":  "padding_top",
                         "min":  0,
                         "max":  100,
                         "step":  4,
                         "unit":  "px",
                         "label":  "Padding Top",
                         "default":  96
                     },
                     {
                         "type":  "range",
                         "id":  "padding_bottom",
                         "min":  0,
                         "max":  100,
                         "step":  4,
                         "unit":  "px",
                         "label":  "Padding Bottom",
                         "default":  96
                     }
                 ],
    "blocks":  [
                   {
                       "type":  "feature",
                       "name":  "Feature",
                       "settings":  [
                                        {
                                            "type":  "text",
                                            "id":  "title",
                                            "label":  "Title",
                                            "default":  "Feature Title"
                                        },
                                        {
                                            "type":  "textarea",
                                            "id":  "desc",
                                            "label":  "Description",
                                            "default":  "Feature description text."
                                        },
                                        {
                                            "type":  "html",
                                            "id":  "icon_svg",
                                            "label":  "Icon SVG (Optional)",
                                            "info":  "Paste SVG code here to override the default star."
                                        }
                                    ]
                   }
               ],
    "presets":  [
                    {
                        "name":  "Features",
                        "blocks":  [
                                       {
                                           "type":  "feature",
                                           "settings":  {
                                                            "title":  "Fast Shipping",
                                                            "desc":  "Get it tomorrow"
                                                        }
                                       },
                                       {
                                           "type":  "feature",
                                           "settings":  {
                                                            "title":  "Secure Payment",
                                                            "desc":  "100% Secure"
                                                        }
                                       },
                                       {
                                           "type":  "feature",
                                           "settings":  {
                                                            "title":  "24/7 Support",
                                                            "desc":  "We are here for you"
                                                        }
                                       }
                                   ]
                    }
                ]
}
{% endschema %}

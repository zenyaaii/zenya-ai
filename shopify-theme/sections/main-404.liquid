
<div class="py-32 bg-slate-50 text-center min-h-[60vh] flex flex-col items-center justify-center">
  <div class="container mx-auto px-6">
    <div class="text-9xl mb-4">🤷‍♂️</div>
    <h1 class="text-4xl font-extrabold text-slate-900 mb-4">{{ section.settings.title }}</h1>
    <p class="text-slate-600 mb-8 max-w-md mx-auto">{{ section.settings.text }}</p>
    <a href="{{ routes.root_url }}" class="inline-flex items-center justify-center rounded-full px-8 py-3 text-lg font-bold text-white shadow-lg transition hover:opacity-90 hover:scale-105" style="background-color: {{ settings.primary_color }};">
      {{ section.settings.button_label }}
    </a>
  </div>
</div>
{% schema %}
{
  "name": "404 Page",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Page Not Found"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "The page you are looking for might have been removed, had its name changed, or is temporarily unavailable."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Back to Home"
    }
  ]
}
{% endschema %}
  
# ==========================================
# SUPABASE (Database & Auth)
# Get these from: Supabase Dashboard > Project Settings > API
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ==========================================
# STRIPE (Payments)
# Get these from: Stripe Dashboard > Developers > API Keys
# ==========================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_... (From Developers > Webhooks)
STRIPE_PRODUCT_ID=prod_... (Product ID for the subscription)
STRIPE_PRICE_ID_BIMONTHLY=price_... (Price ID for the $4.99/2mo plan)

# ==========================================
# OPENAI (Content Generation)
# Get this from: platform.openai.com > API Keys
# ==========================================
OPENAI_API_KEY=sk-...

# ==========================================
# SCRAPERAPI (Product Scraping)
# Get this from: scraperapi.com > Dashboard
# ==========================================
SCRAPERAPI_KEY=your-scraper-api-key

# ==========================================
# SHOPIFY APP
# Get these from: Shopify Partners Dashboard > Apps
# ==========================================
SHOPIFY_API_KEY=your-api-key
NEXT_PUBLIC_SHOPIFY_API_KEY=your-api-key
SHOPIFY_API_SECRET=your-api-secret
SHOPIFY_APP_URL=https://your-app-url.com
SHOPIFY_SCOPES=write_themes,read_themes,read_products

